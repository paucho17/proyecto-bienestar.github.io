# Copiar este archivo como .env y ajustar los valores.
DJANGO_SECRET_KEY=cambia-esta-clave-en-produccion
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos MySQL (XAMPP)
# En XAMPP por defecto: usuario 'root', sin contraseña, puerto 3306.
DB_NAME=bienestar_iub
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Poner en True solo si aún no tienen XAMPP/MySQL levantado
DJANGO_USE_SQLITE=False
